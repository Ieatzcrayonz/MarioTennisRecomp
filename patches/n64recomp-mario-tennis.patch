-void N64Recomp::LiveGenerator::emit_function_call(const Context&, size_t function_index) const {
+void N64Recomp::LiveGenerator::emit_translate_temp1() const {
+    if (inputs.translate_address == nullptr) {
+        return;
+    }
+    // Sign-extended KSEG0 addresses (0xFFFFFFFF80000000-0xFFFFFFFF9FFFFFFF) map to 0-0x1FFFFFFF after this xor.
+    const sljit_sw kseg0 = sljit_sw(int64_t(int32_t(0x80000000)));
+    sljit_emit_op2(compiler, SLJIT_XOR, Registers::arithmetic_temp1, 0, Registers::arithmetic_temp1, 0, SLJIT_IMM, kseg0);
+    sljit_emit_op2u(compiler, SLJIT_AND | SLJIT_SET_Z, Registers::arithmetic_temp1, 0, SLJIT_IMM, ~sljit_sw(0x1FFFFFFF));
+    sljit_jump* fast = sljit_emit_jump(compiler, SLJIT_ZERO);
+    // Slow path: restore the address, spill the other scratch registers, call the translator.
+    sljit_emit_op2(compiler, SLJIT_XOR, Registers::arithmetic_temp1, 0, Registers::arithmetic_temp1, 0, SLJIT_IMM, kseg0);
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_MEM1(SLJIT_SP), 0, Registers::arithmetic_temp2, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_MEM1(SLJIT_SP), 8, Registers::arithmetic_temp3, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_MEM1(SLJIT_SP), 16, Registers::arithmetic_temp4, 0);
+    sljit_emit_fop1(compiler, SLJIT_MOV_F64, SLJIT_MEM1(SLJIT_SP), 24, SLJIT_FR0, 0);
+    sljit_emit_icall(compiler, SLJIT_CALL, SLJIT_ARGS1(W, W), SLJIT_IMM, sljit_sw(inputs.translate_address));
+    sljit_emit_op1(compiler, SLJIT_MOV, Registers::arithmetic_temp1, 0, SLJIT_RETURN_REG, 0);
+    sljit_emit_op1(compiler, SLJIT_MOV, Registers::arithmetic_temp2, 0, SLJIT_MEM1(SLJIT_SP), 0);
+    sljit_emit_op1(compiler, SLJIT_MOV, Registers::arithmetic_temp3, 0, SLJIT_MEM1(SLJIT_SP), 8);
+    sljit_emit_op1(compiler, SLJIT_MOV, Registers::arithmetic_temp4, 0, SLJIT_MEM1(SLJIT_SP), 16);
+    sljit_emit_fop1(compiler, SLJIT_MOV_F64, SLJIT_FR0, 0, SLJIT_MEM1(SLJIT_SP), 24);
+    sljit_jump* done = sljit_emit_jump(compiler, SLJIT_JUMP);
+    // Fast path: just undo the xor.
+    sljit_set_label(fast, sljit_emit_label(compiler));
+    sljit_emit_op2(compiler, SLJIT_XOR, Registers::arithmetic_temp1, 0, Registers::arithmetic_temp1, 0, SLJIT_IMM, kseg0);
+    sljit_set_label(done, sljit_emit_label(compiler));
+}
+
+void N64Recomp::LiveGenerator::emit_function_call(const Context& recomp_context, size_t function_index) const {
+    const Function& target = recomp_context.functions[function_index];
+    if (inputs.lookup_uncompiled_functions && (target.ignored || target.reimplemented)) {
+        emit_function_call_lookup(target.vram);
+        return;
+    }
     // Load rdram and ctx into R0 and R1.
     sljit_emit_op2(compiler, SLJIT_ADD, SLJIT_R0, 0, Registers::rdram, 0, SLJIT_IMM, rdram_offset);
     sljit_emit_op1(compiler, SLJIT_MOV, SLJIT_R1, 0, Registers::ctx, 0);
